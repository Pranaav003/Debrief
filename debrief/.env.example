# Supabase (NEXT_PUBLIC_* are exposed to the browser — use URL + anon only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never use NEXT_PUBLIC_ for this key
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (server only — API routes)
OPENAI_API_KEY=

# Resend (server only — API routes)
RESEND_API_KEY=

# Optional: verified sender in Resend
RESEND_FROM_EMAIL=

# Optional: canonical site URL for metadata / email footers.
# Production: https://debrief.pranaaviyer.com
NEXT_PUBLIC_SITE_URL=

# Server-side self-fetch (e.g. /share/[slug] calling this app’s API).
# Production: https://debrief.pranaaviyer.com — Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Zoom OAuth (server only — must match the redirect URL in your Zoom app exactly)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Preferred; falls back to ZOOM_REDIRECT_URL, then NEXT_PUBLIC_APP_URL + /api/zoom/callback
ZOOM_REDIRECT_URI=http://localhost:3000/api/zoom/callback
# Legacy alias for ZOOM_REDIRECT_URI
ZOOM_REDIRECT_URL=

# Upstash Redis (rate limiting — API routes)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
