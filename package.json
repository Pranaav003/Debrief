{
  "name": "debrief",
  "version": "0.1.0",
  "private": true,
  "description": "DeBrief for Zoom — AI meeting summaries",
  "scripts": {
    "clean": "rm -rf .next",
    "dev": "next dev -p 3000",
    "dev:clean": "npm run clean && next dev -p 3000",
    "dev:turbo": "npm run clean && next dev -p 3000 --turbo",
    "build": "next build",
    "build:clean": "npm run clean && next build",
    "start": "next start",
    "lint": "next lint",
    "test:pipeline": "npm run lint && npm run build",
    "test:api": "node scripts/test-debrief-api.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "axios": "^1.15.0",
    "lucide-react": "^1.6.0",
    "next": "14.2.35",
    "openai": "^4.104.0",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.9.4",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
